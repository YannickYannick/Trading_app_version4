# Guillemets doubles : avec bash -c '...' $PORT n'est pas expandé (bind invalide) → 502 / pas de gunicorn dans les logs.
web: bash -c "export DJANGO_SETTINGS_MODULE=config_django.settings.production && python manage.py collectstatic --noinput && python manage.py migrate --noinput && echo [debug-e5b425] hypothesisB port=${PORT} && exec gunicorn config_django.wsgi:application --bind 0.0.0.0:$PORT"
